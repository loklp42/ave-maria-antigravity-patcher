{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AntigravityPatcher",
  "version": "2.34.0",
  "identifier": "dev.avemaria.antigravity-patcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ave Maria Patcher",
        "width": 680,
        "height": 680,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "center": true,
        "backgroundColor": "#0a0b0f"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
